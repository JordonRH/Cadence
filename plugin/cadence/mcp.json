{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "cadence": {
      "type": "streamable-http",
      "url": "https://learning.jrhtechservices.party/mcp/",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["learning.read"],
            "defaultScopes": ["learning.read", "learning.write"]
          }
        }
      }
    }
  }
}
